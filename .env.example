# Required: Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for admin access. Create this exact user in Supabase Auth.
ADMIN_EMAIL=

# Required in production. Use at least 32 random bytes; never expose it publicly.
RATE_LIMIT_IP_HASH_SECRET=

# Required by Vercel Cron. Generate a separate server-only secret (32+ chars).
CRON_SECRET=

# Optional operational settings
SUBMISSION_RATE_LIMIT_MAX=5
SUBMISSION_INIT_REQUEST_RATE_LIMIT_MAX=30
SUBMISSION_RATE_LIMIT_WINDOW_MINUTES=60

# Optional public settings. Missing values disable the related UI/integration cleanly.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_META_PIXEL_ID=
