{
  "name": "autopost",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.16",
      "zod": "4.3.6"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm remotion:bundle && next build",
    "remotion:bundle": "remotion bundle src/remotion/index.ts --out-dir .remotion",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "pnpm dlx supabase@latest test db",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/noto-sans-georgian": "5.2.8",
    "@hookform/resolvers": "5.4.0",
    "@remotion/google-fonts": "4.0.489",
    "@remotion/transitions": "4.0.489",
    "@remotion/vercel": "4.0.489",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.2",
    "@vercel/sandbox": "1.6.0",
    "archiver": "8.0.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.81.0",
    "remotion": "4.0.489",
    "satori": "0.26.0",
    "sharp": "0.34.5",
    "workflow": "4.6.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.489",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/archiver": "8.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
