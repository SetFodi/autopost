# Required locally and in Vercel Production. Preview deployments must use a
# separate staging project or omit all Supabase values (presentation-only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional legacy fallbacks during migration to modern Supabase API keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for admin access. Create this exact user in the matching Supabase Auth project.
ADMIN_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=

# Required in production. Use distinct 32+ byte values for staging if enabled.
RATE_LIMIT_IP_HASH_SECRET=

# Required to create unguessable, stable customer result links. Use a distinct
# random 32+ byte secret in every environment and never rotate it casually.
RESULT_TOKEN_SECRET=

# Required by Vercel Cron in Production only. Generate a separate 32+ char secret.
CRON_SECRET=

# Optional operational settings
SUBMISSION_RATE_LIMIT_MAX=3
SUBMISSION_INIT_REQUEST_RATE_LIMIT_MAX=30
SUBMISSION_RATE_LIMIT_WINDOW_MINUTES=60

# Campaign media gate. Keep "development" locally so licensed demo media can
# render. Set "real" in Production only after every file documented in
# public/campaign/README.md exists and config/campaign-assets.json is complete.
# Production never falls back to demo media.
CAMPAIGN_ASSET_SET=development

# Required before a paid campaign except NEXT_PUBLIC_FACEBOOK_URL, which is optional.
# Missing values still fail safely during local development.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Configure the real Pixel ID in Vercel Production only. Leave previews inert,
# or use a separate staging/test Pixel that cannot pollute production events.
NEXT_PUBLIC_META_PIXEL_ID=

# TBC Checkout production merchant credentials. Payment UI remains disabled
# until all three values are configured. Reel rendering uses Vercel Sandbox
# with deployment OIDC automatically, so it needs no separate cloud keys.
TBC_API_KEY=
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
TBC_API_BASE_URL=https://api.tbcbank.ge/v1
